---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  link?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, link, linkLabel } = Astro.props;
---

<div class="section-heading reveal">
  <div>
    <p class="kicker">{eyebrow}</p>
    <h2>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {
    link && (
      <a class="text-link" href={link}>
        {linkLabel ?? 'Ver más'} <span aria-hidden="true">↗</span>
      </a>
    )
  }
</div>
