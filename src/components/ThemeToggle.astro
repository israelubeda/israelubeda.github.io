<button class="theme-toggle" type="button" aria-label="Cambiar tema de color" data-theme-toggle>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
    ></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
  <span class="sr-only" data-theme-label>Tema</span>
</button>

<script is:inline>
  const themeButton = document.querySelector('[data-theme-toggle]');
  const themeLabel = document.querySelector('[data-theme-label]');
  const setLabel = () => {
    if (!themeLabel) return;
    themeLabel.textContent =
      document.documentElement.dataset.theme === 'dark' ? 'Usar tema claro' : 'Usar tema oscuro';
  };
  setLabel();
  themeButton?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    setLabel();
  });
</script>
