---
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article class:list={['project-card reveal', { 'project-card--featured': featured }]}>
  <a class="project-image" href={`/proyectos/${project.slug}/`} aria-label={`Ver ${project.name}`}>
    <img
      src={project.image}
      alt={project.imageAlt}
      loading="lazy"
      width="1200"
      height="600"
      decoding="async"
    />
    <span class="project-number" aria-hidden="true">{String(project.order).padStart(2, '0')}</span>
  </a>
  <div class="project-content">
    <p class="project-eyebrow">{project.eyebrow}</p>
    <h3><a href={`/proyectos/${project.slug}/`}>{project.name}</a></h3>
    <p>{project.description}</p>
    {project.attribution && <p class="project-attribution">{project.attribution}</p>}
    <ul class="tag-list" aria-label="Tecnologías">
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="project-footer">
      <span class="status"><i></i>{project.status}</span>
      <a
        class="arrow-link"
        href={`/proyectos/${project.slug}/`}
        aria-label={`Ver detalles de ${project.name}`}>→</a
      >
    </div>
  </div>
</article>
