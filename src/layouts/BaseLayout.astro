---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { site } from '@/data/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  image = '/img/avatar-icon.png',
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const absoluteImage = new URL(image, site.url);
const pageTitle = title === site.title ? title : `${title} — Israel Ubeda`;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: new URL('/img/ambar.jpeg', site.url).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
  sameAs: [site.github, site.x],
  knowsAbout: ['Python', 'Odoo ERP', 'Automatización', 'Inteligencia artificial', 'APIs'],
};
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="color-scheme" content="dark light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog de Israel Ubeda"
      href="/feed.xml"
    />
    <link rel="icon" href="/img/avatar-icon.png" sizes="512x512" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={`Vista previa de ${pageTitle}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const preferred = window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="noise" aria-hidden="true"></div>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>
