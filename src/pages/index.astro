---
import { getCollection } from 'astro:content';
import BlogCard from '@/components/BlogCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { visibleProjects } from '@/data/projects';
import { technologies } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { postDate } from '@/lib/content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => postDate(b).valueOf() - postDate(a).valueOf())
  .slice(0, 3);
const featured = visibleProjects.filter((project) => project.featured);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="shell hero-shell">
      <div class="hero-copy">
        <p class="kicker">Desarrollo de software · Santiago, Chile</p>
        <h1>Ideas complejas.<br /><span>Software claro.</span></h1>
        <p class="hero-lead">
          Desarrollo soluciones con Python, automatización, Odoo e inteligencia artificial,
          conectando sistemas y procesos con una mirada práctica.
        </p>
        <div class="hero-actions">
          <a class="button" href="#proyectos"
            >Explorar proyectos <span aria-hidden="true">↓</span></a
          >
          <a class="button button--secondary" href="/contacto/"
            >Hablemos <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <div class="hero-orbit" aria-label="Áreas de especialización">
        <div class="orbit-core"><span>IU</span><small>build / learn / iterate</small></div>
        <span class="orbit-label orbit-label--one">Python</span>
        <span class="orbit-label orbit-label--two">Odoo</span>
        <span class="orbit-label orbit-label--three">LLM</span>
        <span class="orbit-label orbit-label--four">APIs</span>
      </div>
    </div>
    <div class="shell hero-strip">
      <span>01 · Software</span><span>02 · Automatización</span><span>03 · IA local</span><span
        >04 · Sistemas empresariales</span
      >
    </div>
  </section>

  <section class="section" id="proyectos">
    <div class="shell">
      <SectionHeading
        eyebrow="Trabajo seleccionado"
        title="Proyectos que convierten reglas en herramientas."
        description="Una selección editorial de repositorios públicos propios, verificados y documentados sin atribuir forks ni resultados no comprobados."
        link="/proyectos/"
        linkLabel="Ver catálogo completo"
      />
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} featured />)}
      </div>
    </div>
  </section>

  <section class="section section--bordered value-section">
    <div class="shell value-grid">
      <div class="value-intro reveal">
        <p class="kicker">Cómo aporto valor</p>
        <h2>De la necesidad operativa a una solución mantenible.</h2>
        <p>
          Mi foco está en entender el proceso, reducir trabajo repetitivo y construir una base
          técnica que se pueda explicar, probar y mejorar.
        </p>
      </div>
      <ol class="value-list">
        <li class="reveal">
          <span>01</span><div>
            <h3>Automatizar</h3><p>
              Scripts, integraciones y herramientas que reducen tareas manuales.
            </p>
          </div>
        </li>
        <li class="reveal">
          <span>02</span><div>
            <h3>Integrar</h3><p>
              APIs, datos y sistemas empresariales trabajando como un flujo coherente.
            </p>
          </div>
        </li>
        <li class="reveal">
          <span>03</span><div>
            <h3>Experimentar</h3><p>
              IA, agentes y modelos locales evaluados con una mirada práctica.
            </p>
          </div>
        </li>
        <li class="reveal">
          <span>04</span><div>
            <h3>Documentar</h3><p>
              Decisiones técnicas visibles para facilitar mantenimiento y aprendizaje.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--bordered tech-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Caja de herramientas"
        title="Tecnologías con propósito, no por tendencia."
        description="Selección basada en las áreas declaradas y el trabajo público disponible."
        link="/experiencia/"
        linkLabel="Ver experiencia y enfoque"
      />
      <div class="tech-marquee" aria-label="Tecnologías">
        {
          technologies.map((technology, index) => (
            <span>
              <i>{String(index + 1).padStart(2, '0')}</i>
              {technology}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="shell">
      <SectionHeading
        eyebrow="Notas de campo"
        title="Aprender también es publicar."
        description="Artículos históricos sobre Python, Odoo, Linux, automatización y modelos locales, conservando sus fechas y rutas originales."
        link="/blog/"
        linkLabel="Explorar el blog"
      />
      <div class="blog-list">
        {posts.map((post, index) => <BlogCard post={post} index={index} />)}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="shell cta-inner reveal">
      <p class="kicker">Siguiente proyecto</p>
      <h2>¿Hay un proceso que podría funcionar mejor?</h2>
      <p>Conversemos sobre software, automatización o una integración que necesite tomar forma.</p>
      <a class="button" href="mailto:israel.ubedabravo@gmail.com"
        >Escribir un correo <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 78px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .hero-grid {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
    opacity: 0.45;
  }
  .hero::before {
    position: absolute;
    z-index: -1;
    top: 12%;
    left: 42%;
    width: 45rem;
    height: 45rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow), transparent 66%);
    content: '';
  }
  .hero-shell {
    display: grid;
    gap: 4rem;
    align-items: center;
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  .hero-copy {
    max-width: 820px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(3.6rem, 11vw, 9.2rem);
    font-weight: 760;
    letter-spacing: -0.085em;
    line-height: 0.82;
  }
  .hero h1 span {
    color: transparent;
    -webkit-text-stroke: 1px var(--text);
  }
  .hero-lead {
    max-width: 680px;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero-orbit {
    position: relative;
    display: none;
    width: 330px;
    height: 330px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .hero-orbit::before,
  .hero-orbit::after {
    position: absolute;
    border: 1px dashed var(--line);
    border-radius: 50%;
    content: '';
  }
  .hero-orbit::before {
    inset: 2.6rem;
  }
  .hero-orbit::after {
    inset: 5.2rem;
  }
  .orbit-core {
    z-index: 2;
    display: grid;
    width: 9rem;
    height: 9rem;
    place-items: center;
    align-content: center;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    box-shadow: 0 0 80px var(--glow);
  }
  .orbit-core span {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.12em;
  }
  .orbit-core small {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    text-transform: uppercase;
  }
  .orbit-label {
    position: absolute;
    z-index: 3;
    padding: 0.28rem 0.5rem;
    border: 1px solid var(--line);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }
  .orbit-label--one {
    top: 1rem;
    left: 5.4rem;
  }
  .orbit-label--two {
    top: 6.2rem;
    right: -0.8rem;
  }
  .orbit-label--three {
    right: 4rem;
    bottom: 0.8rem;
  }
  .orbit-label--four {
    bottom: 5.6rem;
    left: -1rem;
  }
  .hero-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
  }
  .value-section {
    background: var(--surface);
  }
  .value-grid {
    display: grid;
    gap: 4rem;
  }
  .value-intro h2 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 5rem);
    letter-spacing: -0.065em;
    line-height: 0.95;
  }
  .value-intro > p:last-child {
    color: var(--muted);
    font-size: 1.1rem;
  }
  .value-list {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .value-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .value-list li > span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .value-list h3,
  .value-list p {
    margin: 0;
  }
  .value-list h3 {
    font-size: 1.25rem;
  }
  .value-list p {
    color: var(--muted);
  }
  .tech-marquee {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .tech-marquee span {
    display: flex;
    flex: 1 1 220px;
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 1.3rem;
    font-weight: 700;
    transition:
      background 180ms ease,
      color 180ms ease;
  }
  .tech-marquee span:hover {
    background: var(--text);
    color: var(--bg);
  }
  .tech-marquee i {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-style: normal;
  }
  .cta-section {
    padding-block: clamp(5rem, 10vw, 10rem);
    background: var(--accent);
    color: #fff;
  }
  .cta-inner h2 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    letter-spacing: -0.075em;
    line-height: 0.88;
  }
  .cta-inner .kicker {
    color: #fff;
  }
  .cta-inner p:not(.kicker) {
    max-width: 620px;
    font-size: 1.15rem;
  }
  .cta-inner .button {
    margin-top: 1rem;
    border-color: #fff;
    background: #fff;
    color: #17191b;
  }
  @media (min-width: 900px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1fr) 330px;
    }
    .hero-orbit {
      display: grid;
    }
    .hero-strip {
      grid-template-columns: repeat(4, 1fr);
    }
    .value-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-orbit {
      animation: float 7s ease-in-out infinite;
    }
    @keyframes float {
      50% {
        transform: translateY(-10px) rotate(1deg);
      }
    }
  }
</style>
